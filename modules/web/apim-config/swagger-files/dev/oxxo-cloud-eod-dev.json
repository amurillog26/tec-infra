            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EodDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/EodDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/EodDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
