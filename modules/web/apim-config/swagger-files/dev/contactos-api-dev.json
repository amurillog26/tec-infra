{
    "swagger": "2.0",
    "info": {
        "title": "Demo Contacts API",
        "description": "A sample API with information related to a Contacs directory.",
        "version": "2.0.0"
    },
    "host": "contactos-api-dev.apps.tec-dev.southcentralus.aroapp.io",
    "schemes": [
        "http",
        "https"
    ],
    "securityDefinitions": {
        "apiKeyHeader": {
            "type": "apiKey",
            "name": "Ocp-Apim-Subscription-Key",
            "in": "header"
        },
        "apiKeyQuery": {
            "type": "apiKey",
            "name": "subscription-key",
            "in": "query"
        }
    },
    "security": [
        {
            "apiKeyHeader": []
        },
        {
            "apiKeyQuery": []
        }
    ],
    "paths": {
        "/api/v1/contact": {
            "get": {
                "description": "A list of Contacts.",
                "operationId": "GetContacts",
                "parameters": [
                    {
                        "name": "nombre",
                        "in": "query",
                        "type": "string"
                    },
                    {
                        "name": "email",
                        "in": "query",
                        "description": "The email of contact",
                        "type": "integer"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                },
                "produces": [
                    "application/vnd.collection+json"
                ]
            }
        }
    }
}
