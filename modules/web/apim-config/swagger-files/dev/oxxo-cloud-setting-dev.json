              "type": "string"
            }
          },
          {
            "name": "crStore",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "numDevice",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "version",
