# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars.json

# Ignore override files as they are usually used for local development
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock files (opcional, algunos equipos prefieren versionarlos)
# .terraform.lock.hcl

# Ignore environment specific vars (si usas archivos .env)
.env
*.env

# Ignore Mac/OSX system files
.DS_Store

# Ignore VS Code settings
.vscode/

# Ignore IntelliJ IDEA settings
.idea/

# Ignore logs
*.log

# Ignore plan output files
*tfplan*
plan.out
plan.json

# Ignore any local backup files
*.bak
*.backup
*~

# Ignore any generated documentation
docs/generated/
