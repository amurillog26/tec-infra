# --------------------------------------------------
# Archivo: keyvault_secrets.tf
# --------------------------------------------------

locals {
  # Nombres de recursos dinámicos basados en el ambiente
  storage_account_name = "stgpt${var.environment}01"
  cosmos_account_name = "cosmos-gpt-db-${var.environment}-01"
  acr_name = "crgptoai${var.environment}01"
  
  # La clave del recurso Redis en var.redis_cache
  redis_cache_map_key = "redis_gpt_cache_${var.environment}"
  
  # El nombre real del recurso Redis tal como aparece en Azure
  redis_name = "redis-gpt-cache-${var.environment}-01"
  
  # Crear una lista plana de todos los secretos desde la estructura anidada
  flat_secrets = flatten([
    for category, secrets in var.key_vault_secrets : [
      for secret in secrets : {
        name     = secret
        category = category
      }
    ]
  ])

  # Mapeo de secretos que pueden generarse automáticamente
  generated_secrets = {
    # Storage Account
    "${local.storage_account_name}-key" = module.storage.storage_accounts[local.storage_account_name].primary_access_key
    "${local.storage_account_name}-connection-string" = module.storage.storage_accounts[local.storage_account_name].primary_blob_endpoint
    "btc-blob-conv-account-key" = module.storage.storage_accounts[local.storage_account_name].primary_access_key
    "btc-blob-conv-account-name" = local.storage_account_name
    
    # Cosmos DB
    "${local.cosmos_account_name}-primary-key" = module.cosmos_db.cosmos_db_primary_key
    "${local.cosmos_account_name}-secondary-key" = module.cosmos_db.cosmos_db_primary_key  # En este caso es la misma, pero podrías usar secondary_key si está disponible
    "${local.cosmos_account_name}-connection-string" = "AccountEndpoint=${module.cosmos_db.cosmos_db_endpoint};AccountKey=${module.cosmos_db.cosmos_db_primary_key};"
    
    # Container Registry
    "${local.acr_name}-admin-password" = module.container_registry.acr_admin_password
    
    # Redis Cache - Usamos lookup() para evitar errores si la clave no existe
    "redis-gpt-cache-${var.environment}-primary-key" = lookup(var.redis_cache[local.redis_cache_map_key], "primary_key", "")
    "redis-gpt-cache-${var.environment}-secondary-key" = lookup(var.redis_cache[local.redis_cache_map_key], "primary_key", "")
    "btc-redis-password" = lookup(var.redis_cache[local.redis_cache_map_key], "primary_key", "")
    "btc-redis-address" = "${local.redis_name}.redis.cache.windows.net"
    "btc-redis-port" = "6380"  # Puerto estándar SSL para Redis
    
    # Seguridad - Estos no se generan, pero podrían generarse con un algoritmo determinista
    "jwt-signing-key" = "${sha256("${var.environment}-jwt-key-${formatdate("YYYY-MM-DD", timestamp())}")}"
    "encryption-key" = "${sha256("${var.environment}-encryption-${formatdate("YYYY-MM-DD", timestamp())}")}"
    "btc-pass-encrypt" = "${sha256("${var.environment}-encrypt-${formatdate("YYYY-MM-DD", timestamp())}")}"
  }
}

# Para uso de data source, no es necesario permisos de creación,
# solo necesitamos permisos para obtener los valores de los secretos
data "azurerm_key_vault" "kv" {
  name                = var.kv_name
  resource_group_name = var.main_rg_name

  depends_on = [
    module.key_vault
  ]
}

# Secretos especificados manualmente (no generados)
resource "azurerm_key_vault_secret" "manual_secrets" {
  for_each = { 
    for item in local.flat_secrets : item.name => item
    if !contains(keys(local.generated_secrets), item.name)
  }

  name         = each.value.name
  value        = ""  # Valor vacío inicial
  key_vault_id = data.azurerm_key_vault.kv.id

  lifecycle {
    ignore_changes = [
      value,
      tags
    ]
  }

  tags = merge(var.tags, {
    category = each.value.category
    managed_by = "terraform"
    auto_generated = "false"
  })

  depends_on = [
    module.key_vault
  ]
}

# Secretos generados automáticamente
resource "azurerm_key_vault_secret" "generated_secrets" {
  for_each = {
    for key, value in local.generated_secrets : key => value
    if contains(flatten([for category, secrets in var.key_vault_secrets : secrets]), key)
  }

  name         = each.key
  value        = each.value
  key_vault_id = data.azurerm_key_vault.kv.id
  lifecycle {
    ignore_changes = [
      value,
      tags
    ]
  }
  tags = merge(var.tags, {
    category = "auto-generated"
    managed_by = "terraform"
    auto_generated = "true"
  })

  depends_on = [
    module.key_vault,
    module.storage,
    module.cosmos_db,
    module.container_registry,
    module.redis
  ]
}
